{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevFlow OS",
  "version": "0.1.0",
  "identifier": "app.devflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @devflow/desktop dev",
    "devUrl": "http://localhost:5288",
    "beforeBuildCommand": "pnpm --filter @devflow/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevFlow OS — AI Engineering Control Plane",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:47710 ws://127.0.0.1:47710 http://localhost:5288 ws://localhost:5288; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/devflow-daemon"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
